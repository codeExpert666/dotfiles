#cloud-config
users:
  - default
ssh_authorized_keys:
  - __SSH_PUBLIC_KEY__
ssh_pwauth: false
disable_root: true
timezone: Asia/Shanghai
locale: C.UTF-8
package_update: true
package_upgrade: true
package_reboot_if_required: false
packages:
  - git
  - ca-certificates
  - python3
write_files:
  - path: /var/lib/dotfiles-multipass/instance.json
    owner: root:root
    content: __INSTANCE_JSON__
runcmd:
  - chmod 0600 /var/lib/dotfiles-multipass/instance.json
